DINGTALK_APP_KEY=your_dingtalk_app_key
DINGTALK_APP_SECRET=your_dingtalk_app_secret
DINGTALK_PORT=8127

KUAIMAI_APP_KEY=your_kuaimai_app_key
KUAIMAI_APP_SECRET=your_kuaimai_app_secret
KUAIMAI_ACCESS_TOKEN=your_kuaimai_access_token
KUAIMAI_REFRESH_TOKEN=your_optional_kuaimai_refresh_token

# 平台连接保险箱主密钥。仅填写 32 字节 Base64URL 值；生产值只放 ECS runtime.env，禁止提交。
PLATFORM_CREDENTIAL_MASTER_KEY=replace_with_32_byte_base64url_key

# 仅供部署后就绪检查和受控生产修复；npm start 不读取这组配置。
PRODUCTION_DATA_API_URL=https://deshan-tiyes.cn
PRODUCTION_DATA_ACCESS_TOKEN=your_personal_production_data_token

# 仅用于事故回滚；默认必须关闭。开启后总览会显著标记兼容回滚口径。
VITE_DATA_CENTER_LEGACY_OVERVIEW_ROLLBACK=0
