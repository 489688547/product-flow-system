# Copy to /opt/product-flow/config/runtime.env and chmod 600.
# Never commit the populated file.
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
PLATFORM_CREDENTIAL_MASTER_KEY=
DEMO_DATA_MASKING_KEY=
PFS_PUBLIC_API_ORIGIN=https://deshan-tiyes.cn
PFS_PUBLIC_APP_ORIGIN=https://deshan-tiyes.cn
PFS_ALLOWED_BROWSER_ORIGIN=
RUNTIME_ENV=production
COLLECTOR_EXPERIMENTAL_MODE=0
WEB_COLLECTION_EXPERIMENTAL_MODE=0

# Optional private OSS backup target. Prefer an ECS RAM role over access keys.
OSS_BACKUP_URI=
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
