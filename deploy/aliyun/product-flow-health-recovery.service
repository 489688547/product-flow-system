[Unit]
Description=Recover unhealthy Product Flow ECS containers with bounded retries
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/product-flow/app
Environment=PFS_DEPLOY_COMMIT=unknown
ExecStart=/opt/node-v22.22.3/bin/node scripts/aliyun/recover-unhealthy-container.mjs
TimeoutStartSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/product-flow/health-recovery

