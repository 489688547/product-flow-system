{
  "version": 1,
  "apps": [
    { "id": "company-platform", "label": "公司平台", "order": 1 },
    { "id": "product-lifecycle", "label": "产品全周期", "order": 2 },
    { "id": "supply-chain", "label": "供应链", "order": 3 },
    { "id": "data-center", "label": "数据中心", "order": 4 },
    { "id": "ecommerce-operations", "label": "电商运营", "order": 5 },
    { "id": "brand-content", "label": "品牌内容", "order": 6 },
    { "id": "people-performance", "label": "人事绩效", "order": 7 }
  ],
  "endpoints": [
    {
      "id": "collaboration-items-list",
      "appId": "company-platform",
      "title": "协同事项列表",
      "method": "GET",
      "path": "/api/platform/v1/collaboration-items",
      "status": "connected",
      "summary": "按状态、类型、负责人和游标读取共享协同事项。",
      "contract": "collaboration-items-v1.md",
      "auth": "公司会话",
      "permission": "登录员工按服务端可见范围读取",
      "requestExample": { "query": { "status": "open", "pageSize": 30 } },
      "responseExample": { "ok": true, "data": { "items": [], "page": { "nextCursor": null } }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "COLLABORATION_QUERY_INVALID", "COLLABORATION_ACTION_DENIED"],
      "liveTest": { "enabled": true, "query": ["status", "type", "ownerId", "cursor", "pageSize"] }
    },
    {
      "id": "collaboration-items-create",
      "appId": "company-platform",
      "title": "创建协同事项",
      "method": "POST",
      "path": "/api/platform/v1/collaboration-items",
      "status": "connected",
      "summary": "创建带稳定业务键、负责人和初始状态的协同事项。",
      "contract": "collaboration-items-v1.md",
      "auth": "公司会话",
      "permission": "具有对应事项创建权限的员工",
      "requestExample": { "headers": { "Idempotency-Key": "collab-create-20260730-001" }, "body": { "type": "development", "title": "补充 API 目录", "ownerId": "user-1", "priority": "p2" } },
      "responseExample": { "ok": true, "data": { "id": "item-id", "version": 1 }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "COLLABORATION_ACTION_DENIED", "COLLABORATION_VERSION_CONFLICT"]
    },
    {
      "id": "development-backlog-list",
      "appId": "company-platform",
      "title": "研发待办列表",
      "method": "GET",
      "path": "/api/platform/v1/development-backlog",
      "status": "connected",
      "summary": "读取已确认的研发事项、真实分支认领和交付状态。",
      "contract": "development-backlog-v1.md",
      "auth": "公司会话",
      "permission": "总经办与研发治理可读身份",
      "requestExample": { "query": { "status": "in_progress", "moduleId": "company-platform", "page": 1, "pageSize": 30 } },
      "responseExample": { "ok": true, "data": { "items": [], "page": { "page": 1, "pageSize": 30, "total": 0 } }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "DEVELOPMENT_BACKLOG_ACTION_DENIED", "DEVELOPMENT_BACKLOG_QUERY_INVALID"],
      "liveTest": { "enabled": true, "query": ["status", "priority", "moduleId", "ownerId", "query", "page", "pageSize"] }
    },
    {
      "id": "credential-vault-create",
      "appId": "company-platform",
      "title": "新增加密凭据",
      "method": "POST",
      "path": "/api/platform/v1/credential-vault",
      "status": "connected",
      "summary": "将平台账号或内部系统凭据加密写入保险箱。",
      "contract": "credential-vault-v1.md",
      "auth": "公司会话",
      "permission": "总经办或获授权的责任部门",
      "requestExample": { "headers": { "If-Match": "0" }, "body": { "scope": "connector", "providerId": "douyin-ecommerce", "accountName": "示例店铺", "secretFields": { "username": "example@example.com", "password": "[仅在请求中提交]" } } },
      "responseExample": { "ok": true, "data": { "id": "credential-id", "version": 1, "hasSecret": true }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "CREDENTIAL_VAULT_ACTION_DENIED", "CREDENTIAL_VAULT_VERSION_CONFLICT"]
    },
    {
      "id": "product-catalog",
      "appId": "product-lifecycle",
      "title": "商品主数据目录",
      "method": "GET",
      "path": "/api/platform/v1/product-catalog",
      "status": "connected",
      "summary": "读取商品主数据、日期段销量/销售额和最新可信库存。",
      "contract": "product-catalog-v1.md",
      "auth": "公司会话",
      "permission": "员工可读；成本和库存金额按服务端权限返回",
      "requestExample": { "query": { "from": "2026-07-01", "to": "2026-07-28", "platform": "抖音" } },
      "responseExample": { "synced": true, "items": [{ "id": "kuaimai:item:1001", "name": "示例商品", "sales": { "quantity": 12, "netSales": 360 }, "inventory": { "quantity": 128, "status": "available", "snapshotDate": "2026-07-28", "coverage": 1 } }], "meta": { "sales": { "timeBasis": "create_time", "timezone": "Asia/Shanghai" }, "inventory": { "status": "trusted", "coverage": 1 } } },
      "errors": ["AUTH_SESSION_REQUIRED", "PRODUCT_CATALOG_STORAGE_UNAVAILABLE", "PRODUCT_CATALOG_SALES_RANGE_INVALID"],
      "liveTest": { "enabled": true, "query": ["from", "to", "platform"] }
    },
    {
      "id": "goods-flow-inventory",
      "appId": "supply-chain",
      "title": "库存当前与历史快照",
      "method": "GET",
      "path": "/api/platform/v1/goods-flow/inventory",
      "status": "connected",
      "summary": "按完整快照日期、仓库和 SKU 读取库存及质量状态。",
      "contract": "goods-flow-v1.md",
      "auth": "公司会话",
      "permission": "总经办及货流授权部门；金额字段单独授权",
      "requestExample": { "query": { "mode": "current", "asOf": "2026-07-26", "warehouseId": "WH-01" } },
      "responseExample": { "ok": true, "data": [{ "id": "2026-07-26:SKU-001:WH-01", "date": "2026-07-26", "skuId": "SKU-001", "warehouseId": "WH-01", "erpQuantity": 18 }], "quality": { "status": "trusted", "coverage": 1, "latestSnapshotDate": "2026-07-26" }, "page": { "nextCursor": null } },
      "errors": ["AUTH_SESSION_REQUIRED", "GOODS_FLOW_ACTION_DENIED", "GOODS_FLOW_INVENTORY_QUERY_INVALID"],
      "liveTest": { "enabled": true, "query": ["mode", "asOf", "through", "skuId", "warehouseId", "cursor"] }
    },
    {
      "id": "supply-chain-workflows-command",
      "appId": "supply-chain",
      "title": "供应链工作流命令",
      "method": "POST",
      "path": "/api/platform/v1/supply-chain-workflows",
      "status": "connected",
      "summary": "创建或推进采购、付款、供应商、质量和运费工作流。",
      "contract": "supply-chain-workflows-v1.md",
      "auth": "公司会话",
      "permission": "按资源责任部门和动作服务端授权",
      "requestExample": { "headers": { "Idempotency-Key": "purchase-plan-20260730-001", "If-Match": "1" }, "body": { "resourceType": "purchase_plan", "action": "confirm", "resourceId": "plan-id", "reason": "确认采购数量" } },
      "responseExample": { "ok": true, "data": { "resourceId": "plan-id", "version": 2, "status": "confirmed" }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "SUPPLY_CHAIN_ACTION_DENIED", "SUPPLY_CHAIN_VERSION_CONFLICT"]
    },
    {
      "id": "sales-service-summary",
      "appId": "data-center",
      "title": "销售数据汇总",
      "method": "GET",
      "path": "/api/platform/v1/data-services/sales",
      "status": "connected",
      "summary": "发现销售覆盖范围，或按订单创建时间聚合日期段销售。",
      "contract": "data-services-sales-v1.md",
      "auth": "公司会话",
      "permission": "总经办、运营、财务、产品、供应链和采购",
      "requestExample": { "query": { "from": "2026-07-01", "to": "2026-07-28" } },
      "responseExample": { "contract": { "timeBasis": "create_time", "timezone": "Asia/Shanghai", "excludeOther": true }, "query": { "from": "2026-07-01", "to": "2026-07-28" }, "summary": { "rowCount": 0, "quantity": 0, "netSales": 0, "platformCount": 0 } },
      "errors": ["AUTH_SESSION_REQUIRED", "PERMISSION_VIEW_DENIED", "DATA_SERVICE_DATE_RANGE_INVALID", "DATA_SERVICE_QUERY_FAILED"],
      "liveTest": { "enabled": true, "query": ["from", "to"] }
    },
    {
      "id": "sales-service-daily",
      "appId": "data-center",
      "title": "销售日需求事实",
      "method": "GET",
      "path": "/api/platform/v1/data-services/sales/daily",
      "status": "connected",
      "summary": "按日期、库存单位和平台读取供应链使用的原子日需求。",
      "contract": "data-services-sales-v1.md",
      "auth": "公司会话",
      "permission": "总经办、运营、财务、产品、供应链和采购",
      "requestExample": { "query": { "from": "2026-07-01", "to": "2026-07-28", "inventoryUnitId": "SKU-001" } },
      "responseExample": { "contract": { "timeBasis": "create_time", "timezone": "Asia/Shanghai", "excludeOther": true, "grain": ["date", "inventoryUnitId", "platform"] }, "items": [], "quality": { "missing": ["returnQuantity", "promotionIds"] }, "page": { "nextCursor": null } },
      "errors": ["AUTH_SESSION_REQUIRED", "PERMISSION_VIEW_DENIED", "DATA_SERVICE_DATE_RANGE_INVALID", "DATA_SERVICE_QUERY_FAILED"],
      "liveTest": { "enabled": true, "query": ["from", "to", "productId", "inventoryUnitId", "platform", "cursor"] }
    },
    {
      "id": "data-standards-create",
      "appId": "data-center",
      "title": "新增并发布数据口径",
      "method": "POST",
      "path": "/api/platform/v1/data-standards",
      "status": "connected",
      "summary": "使用受控公式结构创建并直接发布口径 v1。",
      "contract": "data-standards-v1.md",
      "auth": "公司会话",
      "permission": "总经办或口径责任部门的数据中心编辑者",
      "requestExample": { "headers": { "Idempotency-Key": "metric-net-sales-v1" }, "body": { "metricCode": "net_sales", "name": "净销售额", "ownerDepartment": "运营部", "effectiveFrom": "2026-08-01", "formula": { "operator": "subtract", "operands": [{ "field": "grossSales" }, { "field": "refundAmount" }] } } },
      "responseExample": { "ok": true, "data": { "id": "metric-id", "metricCode": "net_sales", "version": 1, "status": "published" }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "DATA_STANDARD_ACTION_DENIED", "DATA_STANDARD_FORMULA_INVALID", "DATA_STANDARD_VERSION_CONFLICT"]
    },
    {
      "id": "erp-collection-ingest",
      "appId": "data-center",
      "title": "ERP 文件索引入库",
      "method": "POST",
      "path": "/api/platform/v1/erp-collection/ingest",
      "status": "connected",
      "summary": "接收公司 Mac 已校验的官方 ERP 文件安全索引并投影标准事实。",
      "contract": "erp-collection-v1.md",
      "auth": "公司采集设备 Bearer 或受控生产身份",
      "permission": "固定 runner、provider、resource 和数据环境授权",
      "requestExample": { "headers": { "Idempotency-Key": "erp-batch-20260730-001" }, "body": { "batchId": "batch-id", "providerId": "kuaimai", "resourceType": "inventory_snapshot", "schemaVersion": 1, "records": [{ "sourceKey": "WH-01::SKU-001", "contentHash": "sha256:example", "payload": { "skuCode": "SKU-001", "warehouseName": "主仓", "quantity": 18 } }] } },
      "responseExample": { "ok": true, "data": { "batchId": "batch-id", "inserted": 1, "updated": 0, "unchanged": 0 }, "meta": { "requestId": "request-id" } },
      "errors": ["ERP_COLLECTION_UNAUTHORIZED", "ERP_COLLECTION_PAYLOAD_INVALID", "ERP_COLLECTION_INTERNAL_ERROR"]
    },
    {
      "id": "web-collection-jobs",
      "appId": "data-center",
      "title": "网页采集任务控制",
      "method": "POST",
      "path": "/api/platform/v1/web-collection/jobs",
      "status": "connected",
      "summary": "公司 Mac 采集器领取、续租和完成固定 provider 资源任务。",
      "contract": "web-collection-v1.md",
      "auth": "公司采集 runner Token",
      "permission": "仅登记 runner 和固定任务范围",
      "requestExample": { "body": { "action": "claim", "storeId": "store-1", "leaseSeconds": 300 } },
      "responseExample": { "ok": true, "data": { "job": { "id": "job-id", "providerId": "kuaimai", "resourceType": "inventory_snapshot", "businessDate": "2026-07-30" } } },
      "errors": ["WEB_COLLECTION_RUNNER_UNAUTHORIZED", "WEB_COLLECTION_JOB_CONFLICT", "WEB_COLLECTION_ACTION_INVALID"]
    },
    {
      "id": "platform-connections-list",
      "appId": "data-center",
      "title": "平台连接目录",
      "method": "GET",
      "path": "/api/platform/v1/platform-connections",
      "status": "connected",
      "summary": "读取脱敏的平台连接、配置状态和维护元数据。",
      "contract": "platform-connections-v1.md",
      "auth": "公司会话",
      "permission": "总经办与数据中心授权部门",
      "requestExample": { "query": {} },
      "responseExample": { "ok": true, "data": { "items": [] }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "PLATFORM_CONNECTION_ACTION_DENIED", "PLATFORM_CONNECTION_STORAGE_UNAVAILABLE"],
      "liveTest": { "enabled": true, "query": [] }
    },
    {
      "id": "commerce-facts-read",
      "appId": "ecommerce-operations",
      "title": "电商标准事实",
      "method": "GET",
      "path": "/api/platform/v1/commerce-facts",
      "status": "connected",
      "summary": "读取标准化的店铺、商品、直播和短视频经营事实。",
      "contract": "commerce-facts-v1.md",
      "auth": "公司会话",
      "permission": "经营数据授权员工",
      "requestExample": { "query": { "from": "2026-07-01", "to": "2026-07-23", "providerId": "douyin-ecommerce", "resourceType": "product_daily" } },
      "responseExample": { "ok": true, "data": { "items": [], "quality": { "status": "trusted" }, "page": { "nextCursor": null } }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "COMMERCE_FACTS_QUERY_INVALID", "COMMERCE_FACTS_STORAGE_UNAVAILABLE"],
      "liveTest": { "enabled": true, "query": ["from", "to", "providerId", "storeId", "resourceType", "cursor"] }
    },
    {
      "id": "user-insights-read",
      "appId": "brand-content",
      "title": "用户洞察",
      "method": "GET",
      "path": "/api/platform/v1/user-insights",
      "status": "connected",
      "summary": "读取已确认类目范围内的趋势、规则、竞品和安全聚合。",
      "contract": "user-insights-v1.md",
      "auth": "公司会话",
      "permission": "品牌、产品与总经办授权员工",
      "requestExample": { "query": { "platform": "douyin", "categoryId": "category-1" } },
      "responseExample": { "ok": true, "data": { "items": [], "quality": { "status": "unavailable", "missing": [] } }, "meta": { "requestId": "request-id" } },
      "errors": ["AUTH_SESSION_REQUIRED", "USER_INSIGHTS_ACTION_DENIED", "USER_INSIGHTS_QUERY_INVALID"],
      "liveTest": { "enabled": true, "query": ["platform", "categoryId", "from", "to"] }
    },
    {
      "id": "browser-agent-tasks",
      "appId": "company-platform",
      "title": "浏览器采集任务",
      "method": "GET",
      "path": "/api/platform/v1/browser-agent/tasks",
      "status": "connected",
      "summary": "采集设备领取最多五个已授权的固定 provider 任务。",
      "contract": "browser-agent-v1.md",
      "auth": "设备 Bearer Token",
      "permission": "仅登记的浏览器采集设备",
      "requestExample": { "query": {} },
      "responseExample": { "ok": true, "data": { "tasks": [] }, "meta": { "requestId": "request-id" } },
      "errors": ["BROWSER_AGENT_UNAUTHORIZED", "BROWSER_AGENT_TASK_NOT_FOUND", "BROWSER_AGENT_GRANT_EXPIRED"]
    }
  ]
}
